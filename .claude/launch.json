{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pgwt-registry-entry",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3000
    },
    {
      "name": "pgwt-vercel-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.local; set +a; exec vercel dev --listen 3100"
      ],
      "port": 3100
    }
  ]
}
